# ─────────────────────────────────────────────────────────────
# Himbridge portal — environment variables
# Copy to `.env` (local) or set these in your hosting panel (production).
# ─────────────────────────────────────────────────────────────

# PostgreSQL connection string.
# Local: `npm run db:local` starts an embedded Postgres on port 5433 with these credentials.
DATABASE_URL=postgres://himbridge:himbridge@localhost:5433/himbridge

# Public address of the site, without a trailing slash. Used in email links and auth.
# Production example: https://www.himbridge.trade
APP_URL=http://localhost:3000

# Secret used to sign sessions. Generate one with:  openssl rand -base64 32
BETTER_AUTH_SECRET=change-me-to-a-long-random-string-of-32-chars-or-more

# ── File storage ──────────────────────────────────────────────
# "local" stores uploads on disk in UPLOAD_DIR (needs a persistent volume in production).
# "s3" stores them in any S3-compatible bucket (AWS S3, Cloudflare R2, DigitalOcean Spaces, MinIO…).
STORAGE_DRIVER=local
UPLOAD_DIR=./data/uploads
# S3_BUCKET=himbridge-uploads
# S3_REGION=auto
# S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# ── Email ─────────────────────────────────────────────────────
# Without SMTP_URL, emails are only saved to the outbox (Admin → Email outbox) and logged.
# SMTP_URL=smtps://user:password@smtp.example.com:465
MAIL_FROM="Himbridge <no-reply@himbridge.trade>"

# ── Demo data ─────────────────────────────────────────────────
# `npm run db:seed` refuses to run in production unless this is "true".
# Never enable on the live site: demo accounts share a known password.
ALLOW_DEMO_SEED=false
