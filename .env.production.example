# ─────────────────────────────────────────────────────────────
# Production settings for docker-compose.yml.
# Copy to .env.production on the server and fill in every value. Never commit the real file.
# ─────────────────────────────────────────────────────────────

# Your domain, without https:// (e.g. himbridge.trade). Caddy issues the HTTPS certificate for it.
DOMAIN=himbridge.trade
APP_URL=https://himbridge.trade

# Database password (any long random string):  openssl rand -base64 24
POSTGRES_PASSWORD=

# Session signing secret:  openssl rand -base64 32
BETTER_AUTH_SECRET=

# File uploads: "local" keeps them in the "uploads" Docker volume (back it up!),
# or "s3" for an S3-compatible bucket (recommended once you have real traffic).
STORAGE_DRIVER=local
# S3_BUCKET=
# S3_REGION=auto
# S3_ENDPOINT=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# Outgoing email (verification + password reset). Use your provider's SMTP details
# (Amazon SES, Postmark, Brevo, Zoho, Google Workspace…).
SMTP_URL=smtps://USERNAME:PASSWORD@smtp.example.com:465
MAIL_FROM="Himbridge <no-reply@himbridge.trade>"
